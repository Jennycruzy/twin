#!/usr/bin/env bash
#
# Run the test suite before anything is pushed.
#
# The tests workflow in .github/workflows/tests.yml is the same check on GitHub's runners.
# This one runs on the machine doing the pushing, so the suite gates every push whether or
# not CI is available. Both exist: this one is immediate and local, that one is independent
# and public.
#
# Enabled by pointing git at this directory:
#   git config core.hooksPath ops/git-hooks
#
# To push despite a failure — which should be a deliberate act, not a habit:
#   git push --no-verify

set -euo pipefail

cd "$(dirname "$0")/../.."

printf '\033[1;34m==>\033[0m Running tests before push.\n'

if ! docker compose run --rm -T twin python -m pytest; then
  printf '\n\033[1;31m==>\033[0m Tests failed. Push refused.\n'
  exit 1
fi
