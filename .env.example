# Copy to .env to override. Every value below is the default; the stack runs with no .env at all.

# Pinned so the stack is reproducible. Twin is developed against this tag.
DATAHUB_VERSION=v1.7.0

# Host ports. Deliberately outside DataHub's defaults (9002/8080/5432) so the stack
# cannot collide with anything else already running on the host.
TWIN_FRONTEND_PORT=19002
TWIN_GMS_PORT=18080
TWIN_WAREHOUSE_PORT=15432

WAREHOUSE_DB=warehouse
WAREHOUSE_USER=twin
WAREHOUSE_PASSWORD=twin

# Seeds every random process in the estate generator and the pipeline. Changing this
# changes the estate; leaving it alone makes runs byte-identical.
TWIN_SEED=20260805

# Metadata service auth is disabled in this stack, so no token is required. Set one if
# you point Twin at a DataHub instance that has auth enabled.
DATAHUB_GMS_TOKEN=
